-- SYSTEM REMOTE CALLS (HD Admin Framework Hooks)
-----------------------------------------------------------------------
local function executeRemotePayload(cmd)
    local ReplicatedStorage = game:GetService("ReplicatedStorage")
    local player = game:GetService("Players").LocalPlayer
    
    pcall(function()
        local hdAdmin = ReplicatedStorage:FindFirstChild("HDAdminHDClient")
        if hdAdmin then
            local signals = hdAdmin:FindFirstChild("Signals")
            if signals then
                local createLog = signals:FindFirstChild("CreateLog")
                if createLog then
                    createLog:FireServer({Message = cmd, Player = player, LogType = "chatLogs"})
                end
            end
        end
    end)
    
    pcall(function()
        local hdAdmin = ReplicatedStorage:FindFirstChild("HDAdminHDClient")
        if hdAdmin then
            local signals = hdAdmin:FindFirstChild("Signals")
            if signals then
                local reqMod = signals:FindFirstChild("RequestCommandModification")
                if reqMod then
                    reqMod:InvokeServer(cmd)
                end
            end
        end
    end)
end

