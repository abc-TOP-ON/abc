-- حلقة المزرعة المطلقة مع نظام التجميع المتعدد للصحون
task.spawn(function()
    while true do
        task.wait(0.08) 
        if FastFarmEnabled then
            pcall(function()
                
                -- إخفاء نص التحذير المزعج تلقائياً
                local playerGui = game.Players.LocalPlayer:FindFirstChild("PlayerGui")
                if playerGui then
                    for _, element in pairs(playerGui:GetDescendants()) do
                        if element:IsA("TextLabel") and (element.Text:match("Sinks") or element.Text:match("full")) then
                            element.Visible = false
                        end
                    end
                end

                -- [نظام الطحن الإجباري للصحون المتسخة والمغاسل]
                -- السكربت سيبحث أولاً إذا كان هناك صحون متسخة أو مغاسل تحتاج لتفريغ ويقوم بإنهاءها بالكامل دفعة واحدة
                local foundDirtyWork = true
                while foundDirtyWork and FastFarmEnabled do
                    foundDirtyWork = false
                    for _, obj in pairs(workspace:GetDescendants()) do
                        if obj:IsA("ProximityPrompt") and obj.Enabled then
                            local action = obj.ActionText:lower()
                            local name = obj.Parent.Name:lower()
                            
                            -- أولوية 1: تفريغ وغسيل الصحون في المغسلة فوراً وبشكل متتابع
                            if action:match("wash") or action:match("sink") or action:match("clean") or name:match("sink") or name:match("dishwasher") then
                                fireproximityprompt(obj)
                                task.wait(0.02)
                                fireproximityprompt(obj)
                                task.wait(0.03)
                                foundDirtyWork = true
                                break -- العودة لفحص الماب وتكرار العملية حتى ينتهي الغسيل بالكامل
                            
                            -- أولوية 2: استمرار التقاط الصحون المتسخة من الطاولات دون توقف لصحن واحد
                            elseif action:match("clear") or name:match("dirty") or (action:match("pick") and name:match("dish")) then
                                fireproximityprompt(obj)
                                task.wait(0.04)
                                foundDirtyWork = true
                                break 
                            end
                        end
                    end
                    task.wait(0.01) -- مهلة متناهية الصغر لمنع تعليق اللعبة أثناء حلقة التنظيف المتواصلة
                end

                -- بقية العمليات الروتينية (تعمل فقط عندما يكون المطعم نظيفاً تماماً من الصحون المتسخة والمغاسل مفرغة)
                for _, obj in pairs(workspace:GetDescendants()) do
                    if not FastFarmEnabled then break end
                    
                    if obj:IsA("ProximityPrompt") and obj.Enabled then
                        local action = obj.ActionText:lower()
                        local name = obj.Parent.Name:lower()
                        
                        -- 1. جمع الكاش تلقائياً فوراً
                        if action:match("claim") or action:match("collect") or name:match("cash") or name:match("money") or name:match("coin") then
                            fireproximityprompt(obj)
                            task.wait(0.02)
                        
                        -- 2. التقاط الأكل الجاهز من الفرن أو الكاونتر
                        elseif action:match("take") or action:match("pick") or action:match("get") or (action:match("collect") and (name:match("stove") or name:match("counter"))) then
                            fireproximityprompt(obj)
                            task.wait(0.04)
                            
                        -- 3. تقديم الطعام للزبائن 
                        elseif action:match("serve") or action:match("deliver") or action:match("give") or name:match("customer") or name:match("seat") then
                            fireproximityprompt(obj)
                            task.wait(0.04)
                            
                        -- 4. الطبخ واستقبال الزبائن الجدد
                        elseif action:match("cook") or action:match("order") or name:match("stove") or action:match("seat") or action:match("welcome") then
                            fireproximityprompt(obj)
                            task.wait(0.02)
                        end
                    end
                end
            end)
        end
    end
end)
