local function getProgressBar(progress)
    local totalBars = 22
    local filledBars = math.floor((progress / 100) * totalBars)
    local emptyBars = totalBars - filledBars
    return "[" .. string.rep("█", filledBars) .. string.rep("░", emptyBars) .. "] " .. progress .. "%"
end

local function typeWrite(guiObject, text, delayTime)
    for i = 1, #text do
        guiObject.Text = string.sub(text, 1, i)
        task.wait(delayTime or 0.005)
    end
end

