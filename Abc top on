pcall(function()
    if readfile and isfile and isfile(configFileName) then
        local data = readfile(configFileName)
        local decoded = game:GetService("HttpService"):JSONDecode(data)
        if decoded then
            userConfig = decoded
            task.spawn(applyLoadedConfig)
        end
    end
end)

