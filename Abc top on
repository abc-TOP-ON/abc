MiscTab:Button({
    Title = "Server Hop",
    Desc = "Transfer automatically to a different server",
    Callback = function()
        local teleportService = game:GetService("TeleportService")
        local httpService = game:GetService("HttpService")
        local apiApi = "https://roblox.com" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
        
        local success, result = pcall(function()
            return httpService:JSONDecode(game:HttpGet(apiApi))
        end)
        
        if success and result and result.data then
            for _, server in ipairs(result.data) do
                if server.id ~= game.JobId and server.playing < server.maxPlayers then
                    teleportService:TeleportToPlaceInstance(game.PlaceId, server.id, Player)
                    break
                end
            end
        else
            WindUI:Notify({ Title = "Server Hop", Content = "Failed to find alternative servers.", Duration = 3 })
        end
    end
})

-- 5. Anti-Fling Toggle
local antiFlingEnabled = false
local antiFlingConnection = nil
MiscTab:Toggle({
    Title = "Anti-Fling",
    Desc = "Prevents other players from flinging your character",
    Value = false,
    Callback = function(state)
        antiFlingEnabled = state
        if antiFlingEnabled then
            antiFlingConnection = game:GetService("RunService").Stepped:Connect(function()
                if not antiFlingEnabled then antiFlingConnection:Disconnect() return end
                for _, otherPlayer in ipairs(game:GetService("Players"):GetPlayers()) do
                    if otherPlayer ~= Player and otherPlayer.Character then
                        for _, part in ipairs(otherPlayer.Character:GetChildren()) do
                            if part:IsA("BasePart") then
                                part.CanCollide = false
                                part.Velocity = Vector3.new(0, 0, 0)
                                part.RotVelocity = Vector3.new(0, 0, 0)
                            end
                        end
                    end
                end
            end)
        else
            if antiFlingConnection then antiFlingConnection:Disconnect() end
        end
    end
})

