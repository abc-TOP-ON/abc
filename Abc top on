local flying = false
local flySpeed = 50
local flyConnection = nil
local bv, bg = nil, nil

-- 10. Fly Toggle
PlayerTab:Toggle({
    Title = "Fly",
    Desc = "Toggle flying on or off",
    Value = false,
    Callback = function(state)
        flying = state
        local char = Player.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        
        if not hrp or not hum then return end
        
        if flying then
            bv = Instance.new("BodyVelocity")
            bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
            bv.Velocity = Vector3.new(0, 0, 0)
            bv.Parent = hrp
            
            bg = Instance.new("BodyGyro")
            bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
            bg.CFrame = hrp.CFrame
            bg.Parent = hrp
            
            hum.PlatformStand = true
            
            local camera = workspace.CurrentCamera
            flyConnection = game:GetService("RunService").RenderStepped:Connect(function()
                if not flying or not hrp or not hum then 
                    if flyConnection then flyConnection:Disconnect() end
                    return 
                end
                
                local moveDirection = hum.MoveDirection
                local velocity = Vector3.new(0, 0, 0)
                
                if moveDirection.Magnitude > 0 then
                    velocity = camera.CFrame:VectorToWorldSpace(Vector3.new(moveDirection.X, 0, moveDirection.Z)) * flySpeed
                end
                
                if game:GetService("UserInputService"):IsKeyDown(Enum.KeyCode.Space) then
                    velocity = velocity + Vector3.new(0, flySpeed, 0)
                elseif game:GetService("UserInputService"):IsKeyDown(Enum.KeyCode.LeftShift) then
                    velocity = velocity - Vector3.new(0, flySpeed, 0)
                end
                
                bv.Velocity = velocity
                bg.CFrame = camera.CFrame
            end)
        else
            if flyConnection then flyConnection:Disconnect() end
            if bv then bv:Destroy() bv = nil end
            if bg then bg:Destroy() bg = nil end
            if hum then hum.PlatformStand = false end
        end
    end
})

