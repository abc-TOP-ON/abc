-- Apply configurations to your memory variables upon booting up
local function applyLoadedConfig()
    if Player.Character and Player.Character:FindFirstChildOfClass("Humanoid") then
        if userConfig.AutoSave then
            walkSpeedValue = userConfig.WalkSpeedValue
            jumpPowerValue = userConfig.JumpPowerValue
            gravityValue = userConfig.GravityValue
            spinValue = userConfig.SpinValue
            
            WindUI:Notify({
                Title = "Config Loaded",
                Content = "Your saved settings have been automatically applied!",
                Duration = 3
            })
        end
    end
end

-- Force write active slider states to local workspace file
local function saveCurrentConfig()
    if not userConfig.AutoSave then return end
    userConfig.WalkSpeedValue = walkSpeedValue or 16
    userConfig.JumpPowerValue = jumpPowerValue or 50
    userConfig.GravityValue = gravityValue or 196.2
    userConfig.SpinValue = spinValue or 30
    
    pcall(function()
        if writefile then
            writefile(configFileName, game:GetService("HttpService"):JSONEncode(userConfig))
        end
    end)
end

