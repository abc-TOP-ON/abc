-- ==========================================
--  ANTI-SPAM COPY SYSTEM CONFIGURATION
-- ==========================================

local lastClickTime = 0
local clickCooldown = 1.5 

local function safeCopyToClipboard(textToCopy)
    local currentTime = tick()
    if currentTime - lastClickTime < clickCooldown then
        WindUI:Notify({
            Title = "Copy Failed",
            Content = "Stop spamming! Please wait a moment.",
            Duration = 3
        })
        return
    end
    lastClickTime = currentTime
    
    local success = pcall(function()
        if setclipboard then
            setclipboard(textToCopy)
        elseif toclipboard then
            toclipboard(textToCopy)
        else
            error("No clipboard function found")
        end
    end)
    
    if success then
        WindUI:Notify({
            Title = "Success",
            Content = "Copied to clipboard successfully!",
            Duration = 3
        })
    else
        WindUI:Notify({
            Title = "Copy Failed",
            Content = "Your executor does not support auto-copy.",
            Duration = 3
        })
    end
end

