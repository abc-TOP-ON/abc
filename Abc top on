        if airSwimming then
            -- إجبار حالة الأنيميشن على السباحة طوال فترة التفعيل [1]
            airSwimConnection = game:GetService("RunService").RenderStepped:Connect(function()
                if hum and airSwimming then
                    hum:ChangeState(Enum.HumanoidStateType.Swimming)
                else
                    if airSwimConnection then airSwimConnection:Disconnect() end
                end
            end)
        else
            if airSwimConnection then airSwimConnection:Disconnect() end
            hum:ChangeState(Enum.HumanoidStateType.RunningNoPhysics)
        end
    end
})

